---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body
    class="bg-white text-black dark:bg-gray-900 dark:text-white min-h-screen"
  >
    <nav class="m-auto max-w-96 h-14">
      <ul class="flex justify-around items-center h-14">
        <li>
          <a class="underline p-2 hover:no-underline" href="/">Home</a>
        </li>
        <li>
          <a class="underline p-2 hover:no-underline" href="/about">About</a>
        </li>
        <li>
          <a class="underline p-2 hover:no-underline" href="/blog">Blog</a>
        </li>
      </ul>
    </nav>
    <slot />
  </body>
</html>
